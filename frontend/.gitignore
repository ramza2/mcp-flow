node_modules/
/dist/
/build/
# Root .gitignore (Python) ignores any `build/`/`dist/` dir at any depth, which
# would otherwise swallow application source under src/screens/build. Keep the
# real source tracked.
!/src/**/build/
!/src/**/dist/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

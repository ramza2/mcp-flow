# MCPFlow server deployment configuration.
# Copying this file manually is optional: scripts/deploy.sh creates .env.server interactively.
# Secrets are NOT stored here; they live under infra/secrets/server/.

MCPFLOW_HOST=mcpflow.example.com
MCPFLOW_TRAEFIK_NETWORK=traefik_proxy
MCPFLOW_TRAEFIK_HTTP_ENTRYPOINT=web
MCPFLOW_TRAEFIK_HTTPS_ENTRYPOINT=websecure
MCPFLOW_TRAEFIK_CERTRESOLVER=letsencrypt

MCPFLOW_ENVIRONMENT=pilot
MCPFLOW_DEBUG=false
MCPFLOW_LOG_LEVEL=INFO
MCPFLOW_DOCS_ENABLED=false
MCPFLOW_SESSION_COOKIE_SECURE=true

MCPFLOW_EXECUTION_LEASE_SECONDS=60
MCPFLOW_OUTBOX_POLL_INTERVAL_SECONDS=1.0
MCPFLOW_OUTBOX_BATCH_SIZE=50

# deploy.sh only
MCPFLOW_DEPLOY_HEALTH_TIMEOUT=180

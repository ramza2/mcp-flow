# MCPFlow Compose — non-secret configuration only.
#
# IMPORTANT:
# - Do NOT store passwords, access keys, or DATABASE_URL credentials in this file.
# - Local secrets live under infra/secrets/local/ (gitignored).
# - Generate them with: python infra/scripts/generate_local_secrets.py
#
# Copy to `.env` only if you need to override host ports / tags:
#   cp .env.example .env

# Traefik public HTTP port on the host
MCPFLOW_HTTP_PORT=8080

# Loopback diagnostic ports (compose.local.yaml only)
MCPFLOW_API_DEBUG_PORT=8000
MCPFLOW_POSTGRES_DEBUG_PORT=5432
MCPFLOW_REDIS_DEBUG_PORT=6379
MCPFLOW_MINIO_API_DEBUG_PORT=9000
MCPFLOW_MINIO_CONSOLE_DEBUG_PORT=9001

# Image tag for locally built mcpflow-backend / mcpflow-frontend images
MCPFLOW_IMAGE_TAG=local

# Non-secret application settings passed into the API container
MCPFLOW_ENVIRONMENT=development
MCPFLOW_DEBUG=false
MCPFLOW_LOG_LEVEL=INFO
MCPFLOW_DOCS_ENABLED=true

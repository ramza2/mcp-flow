# MCPFlow Backend — example environment (no real secrets)
MCPFLOW_APP_NAME=MCPFlow API
MCPFLOW_APP_VERSION=0.1.0
MCPFLOW_ENVIRONMENT=development
MCPFLOW_DEBUG=false
MCPFLOW_LOG_LEVEL=INFO
MCPFLOW_API_V1_PREFIX=/api/v1
MCPFLOW_DOCS_ENABLED=true

# Async SQLAlchemy PostgreSQL URL (change credentials locally; do not commit secrets)
MCPFLOW_DATABASE_URL=postgresql+asyncpg://mcpflow:change-me@localhost:5432/mcpflow

# Future canonical services — placeholders only in this skeleton
MCPFLOW_REDIS_URL=redis://localhost:6379/0
MCPFLOW_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
